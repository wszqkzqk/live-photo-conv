#: src/gui.vala:566
msgid "Source Files"
msgstr "Ficheiros de origem"

#: src/gui.vala:567
msgid "Provide a video file (required) and a static image."
msgstr "Forneça um ficheiro de vídeo (obrigatório) e uma imagem estática."

#: src/gui.vala:579
msgid "Video"
msgstr "Vídeo"

#: src/gui.vala:583
msgid ""
"Drop video here\n"
"or click to browse"
msgstr ""
"Solte o vídeo aqui\n"
"ou clique para procurar"

#: src/gui.vala:596
msgid "Main Image"
msgstr "Imagem principal"

#: src/gui.vala:600
msgid ""
"Drop image here\n"
"or click to browse"
msgstr ""
"Solte a imagem aqui\n"
"ou clique para procurar"

#: src/gui.vala:611
msgid "Options"
msgstr "Opções"

#: src/gui.vala:613
msgid "Export metadata"
msgstr "Exportar metadados"

#: src/gui.vala:624
msgid "Save Live Photo As"
msgstr "Gravar Live Photo como"

#: src/gui.vala:647 src/gui.vala:666 src/gui.vala:740 src/gui.vala:755
#: src/gui.vala:852 src/gui.vala:864
msgid "Error"
msgstr "Erro"

#: src/gui.vala:653
msgid "Processing…"
msgstr "A processar…"

#: src/gui.vala:663
msgid "Live photo created"
msgstr "Live Photo criada"

#: src/gui.vala:684 src/gui.vala:769
msgid "Live Photo"
msgstr "Live Photo"

#: src/gui.vala:685
msgid "Select the live photo file to extract from."
msgstr "Selecione o ficheiro Live Photo para extrair."

#: src/gui.vala:687 src/gui.vala:772
msgid ""
"Drop live photo file here\n"
"or click to browse"
msgstr ""
"Solte o ficheiro Live Photo aqui\n"
"ou clique para procurar"

#: src/gui.vala:700
msgid "Export Items"
msgstr "Elementos de exportação"

#: src/gui.vala:701
msgid "Choose what to extract from the live photo."
msgstr "Escolha o que extrair da Live Photo."

#: src/gui.vala:703
msgid "Export Main Image"
msgstr "Exportar imagem principal"

#: src/gui.vala:704
msgid "Export Video"
msgstr "Exportar vídeo"

#: src/gui.vala:705
msgid "Export Frames as Photos"
msgstr "Exportar quadros como fotos"

#: src/gui.vala:706
msgid "Export Long Exposure Photo"
msgstr "Exportar foto de longa exposição"

#: src/gui.vala:707
msgid "Image Format"
msgstr "Formato de imagem"

#: src/gui.vala:707
msgid "auto"
msgstr "automático"

#: src/gui.vala:716 src/gui.vala:840
msgid "Please select a live photo file first"
msgstr "Selecione um ficheiro Live Photo primeiro"

#: src/gui.vala:721
msgid "Select Output Directory"
msgstr "Selecionar diretório de saída"

#: src/gui.vala:744
msgid "Extracting…"
msgstr "A extrair…"

#: src/gui.vala:752
#, c-format
msgid "%u file extracted"
msgid_plural "%u files extracted"
msgstr[0] "%u ficheiro extraído"
msgstr[1] "%u ficheiro extraídos"

#: src/gui.vala:770
msgid "Select the live photo file to repair its XMP metadata."
msgstr "Selecione o ficheiro Live Photo para reparar os seus metadados XMP."

#: src/gui.vala:785
msgid "Repair Options"
msgstr "Opções de reparo"

#: src/gui.vala:787
msgid "Force Repair"
msgstr "Forçar reparo"

#: src/gui.vala:789
msgid ""
"If enabled, skips validation of the existing video offset and\n"
"forces a full-file scan to re-discover the MP4 header position."
msgstr ""
"Se ativado, ignora a validação do deslocamento do vídeo existente e força "
"uma \n"
"verificação completa do ficheiro para voltar a localizar a posição do "
"cabeçalho MP4."

#: src/gui.vala:794
msgid "Advanced"
msgstr "Avançado"

#: src/gui.vala:796
msgid "Manual Video Size"
msgstr "Tamanho manual do vídeo"

#: src/gui.vala:797
msgid "Specify the size of the embedded video in bytes"
msgstr "Especificar o tamanho do vídeo incorporado em bytes"

#: src/gui.vala:798
msgid ""
"If the video size cannot be detected automatically,\n"
"you can manually specify its size in bytes.\n"
"Leave at 0 to use automatic detection."
msgstr ""
"Se o tamanho do vídeo não puder ser detetado automaticamente,\n"
"você pode especificar manualmente o seu tamanho em bytes.\n"
"Deixe em 0 para usar a detecção automática."

#: src/gui.vala:813
msgid ""
"Enter the exact size of the video portion in bytes.\n"
"Only needed if automatic detection fails."
msgstr ""
"Insira o tamanho exato da parte do vídeo em bytes.\n"
"Necessário apenas se a detecção automática falhar."

#: src/gui.vala:823
msgid "Video size in bytes"
msgstr "Tamanho do vídeo em bytes"

#: src/gui.vala:856
msgid "Repairing…"
msgstr "A reparar…"

#: src/gui.vala:861
#, c-format
msgid "%u file repaired"
msgid_plural "%u files repaired"
msgstr[0] "%u ficheiro reparado"
msgstr[1] "%u ficheiros reparados"

#: src/gui.vala:900 src/gui.vala:926
msgid "Extracting"
msgstr "A extrair"

#: src/gui.vala:990 src/gui.vala:1006
msgid "Repairing"
msgstr "A reparar"
