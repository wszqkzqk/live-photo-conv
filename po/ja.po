#: src/gui.vala:599
msgid "Export Items"
msgstr "エクスポート項目"

#: src/gui.vala:600
msgid "Choose what to extract from the live photo."
msgstr "Live Photo から抽出するものを選択してください。"

#: src/gui.vala:602
msgid "Export Main Image"
msgstr "メイン画像をエクスポート"

