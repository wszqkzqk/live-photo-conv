#: src/gui.vala:513
msgid ""
"Drop image here\n"
"or click to browse"
msgstr ""
"Перетащите изображение сюда\n"
"или нажмите для выбора"

#: src/gui.vala:524
msgid "Options"
msgstr "Параметры"

#: src/gui.vala:526
msgid "Export metadata"
msgstr "Экспорт метаданных"

#: src/gui.vala:537
