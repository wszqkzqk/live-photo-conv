msgstr[2] "%u souborů vybráno"

#: src/gui.vala:315 src/gui.vala:662 src/gui.vala:665
msgid "Make Live Photo"
msgstr "Vyrobit živé foto"

#: src/gui.vala:318 src/gui.vala:325 src/gui.vala:751 src/gui.vala:754
msgid "Extract"
msgstr "Extrahovat"

#: src/gui.vala:321 src/gui.vala:326 src/gui.vala:860 src/gui.vala:863
msgid "Repair"
msgstr "Opravit"

#: src/gui.vala:324
msgid "Make"
msgstr "Vytvořit"

#: src/gui.vala:334
msgid "Follow System"
msgstr "Podle systému"

#: src/gui.vala:335
msgid "Light"
msgstr "Světlé"

#: src/gui.vala:336
msgid "Dark"
msgstr "Tmavé"

#: src/gui.vala:340
msgid "Appearance"
msgstr "Vzhled"

#: src/gui.vala:341
msgid "About"
msgstr "O aplikaci"

#: src/gui.vala:566
msgid "Source Files"
msgstr "Zdrojové soubory"

#: src/gui.vala:567
msgid "Provide a video file (required) and a static image."
msgstr "Poskytněte videosoubor (vyžadováno) a statický obrázek."

#: src/gui.vala:579
msgid "Video"
msgstr "Video"

#: src/gui.vala:583
msgid ""
"Drop video here\n"
"or click to browse"
msgstr ""
"Přetáhněte video sem\n"
"Nebo klikněte pro procházení"

#: src/gui.vala:596
msgid "Main Image"
msgstr "Hlavní obrázek"

#: src/gui.vala:600
msgid ""
"Drop image here\n"
"or click to browse"
msgstr ""
"Přetáhněte obrázek sem\n"
"Nebo klikněte pro procházení"

#: src/gui.vala:611
msgid "Options"
msgstr "Předvolby"

#: src/gui.vala:613
msgid "Export metadata"
msgstr "Exportovat metadata"

#: src/gui.vala:624
msgid "Save Live Photo As"
msgstr "Uložit živé foto jako"

#: src/gui.vala:647 src/gui.vala:666 src/gui.vala:740 src/gui.vala:755
#: src/gui.vala:852 src/gui.vala:864
msgid "Error"
msgstr "Chyba"

#: src/gui.vala:653
msgid "Processing…"
msgstr "Zpracovávání…"

#: src/gui.vala:663
msgid "Live photo created"
msgstr "Živé foto vytvořeno"

#: src/gui.vala:684 src/gui.vala:769
msgid "Live Photo"
msgstr "Živé foto"

#: src/gui.vala:685
msgid "Select the live photo file to extract from."
msgstr "Vyberte živé foto, že kterého extrahovat."

#: src/gui.vala:687 src/gui.vala:772
msgid ""
"Drop live photo file here\n"
"or click to browse"
msgstr ""
"Soubor s živým foto přetáhněte sem\n"
"Nebo klikněte pro procházení"

#: src/gui.vala:700
msgid "Export Items"
msgstr "Exportovat položky"

#: src/gui.vala:701
msgid "Choose what to extract from the live photo."
msgstr "Zvolte co z živého foto extrahovat."

#: src/gui.vala:703
msgid "Export Main Image"
msgstr "Exportovat hlavní obrázek"

#: src/gui.vala:704
msgid "Export Video"
msgstr "Exportovat video"

#: src/gui.vala:705
msgid "Export Frames as Photos"
msgstr "Exportovat snímky jako fotky"

#: src/gui.vala:706
msgid "Export Long Exposure Photo"
msgstr "Exportovat foto s dlouhou expozicí"

#: src/gui.vala:707
msgid "Image Format"
msgstr "Formát obrázku"

#: src/gui.vala:707
msgid "auto"
msgstr "automaticky"

#: src/gui.vala:716 src/gui.vala:840
msgid "Please select a live photo file first"
msgstr "Nejprve vyberte soubor obsahující živé foto"

#: src/gui.vala:721
msgid "Select Output Directory"
msgstr "Vyberte výstupní složku"

#: src/gui.vala:744
msgid "Extracting…"
msgstr "Extrahování…"

#: src/gui.vala:752
#, c-format
msgid "%u file extracted"
msgid_plural "%u files extracted"
msgstr[0] "%u soubor extrahován"
msgstr[1] "%u soubory extrahovány"
msgstr[2] "%u souborů extrahováno"

#: src/gui.vala:770
msgid "Select the live photo file to repair its XMP metadata."
msgstr "Vyberte soubor s živým foto k opravení jeho XMP metadat."

#: src/gui.vala:785
msgid "Repair Options"
msgstr "Možnosti opravy"

#: src/gui.vala:787
msgid "Force Repair"
msgstr "Vynutit opravu"

#: src/gui.vala:789
msgid ""
"If enabled, skips validation of the existing video offset and\n"
"forces a full-file scan to re-discover the MP4 header position."
msgstr ""
"Pokud povoleno, přeskočí ověřování existujícího posunu videa a\n"
"vypnutí sken celého souboru pro znovuobjevení pozice MP4 záhlaví."

#: src/gui.vala:794
msgid "Advanced"
msgstr "Pokročilé"

#: src/gui.vala:796
msgid "Manual Video Size"
msgstr "Ruční velikost videa"

#: src/gui.vala:797
msgid "Specify the size of the embedded video in bytes"
msgstr "Zadejte velikost zapouzdřeného videa (v bajtech)"

#: src/gui.vala:798
msgid ""
"If the video size cannot be detected automatically,\n"
"you can manually specify its size in bytes.\n"
"Leave at 0 to use automatic detection."
msgstr ""
"Pokud velikost videa není možné zjistit automaticky,\n"
"je možné ručně zadat jeho velikost (v bajtech).\n"
"Pro použití automatického zjišťování ponechte na 0 (nula)."

#: src/gui.vala:813
msgid ""
"Enter the exact size of the video portion in bytes.\n"
"Only needed if automatic detection fails."
msgstr ""
"Zadejte přesnou velikost videočásti (v bajtech).\n"
"Potřebné pouze pokud se nedaří automatické zjištění."

#: src/gui.vala:823
msgid "Video size in bytes"
msgstr "Velikost videa (v bajtech)"

#: src/gui.vala:856
msgid "Repairing…"
msgstr "Opravování…"

#: src/gui.vala:861
#, c-format
msgid "%u file repaired"
msgid_plural "%u files repaired"
msgstr[0] "%u soubor opraven"
msgstr[1] "%u soubory opraveny"
msgstr[2] "%u souborů opraveno"

#: src/gui.vala:900 src/gui.vala:926
msgid "Extracting"
msgstr "Extrahování"

#: src/gui.vala:990 src/gui.vala:1006
msgid "Repairing"
msgstr "Opravování"
