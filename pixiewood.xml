<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/"
     xmlns:xi="http://www.w3.org/2001/XInclude">
  <metainfo vercalc="sem121010">
  </metainfo>
  <style>
    <theme name="adw"/>
    <icon type="generate">
      <drawable target="foreground" scale=".5" type="svg"
                path="src://android/app-icon-foreground.svg"/>
      <color target="background">#3584e4</color>
    </icon>
  </style>
  <dependencies>
    <glib>
      <patch>hack</patch>
    </glib>
    <cairo/>
    <fontconfig/>
    <gtk/>
  </dependencies>
  <build target="live-photo-conv-gtk"
         java-sources="gdk/android/glue/java/">
    <architectures>
      <arch>aarch64</arch>
    </architectures>
    <configure-options>
      <option>-Dgui=enabled</option>
      <option>-Dgst=enabled</option>
      <option>-Dgir=disabled</option>
      <option>-Dmanpages=disabled</option>
      <option>-Ddocs=disabled</option>
      <option>-Dexiv2:xmp=enabled</option>
      <option>-Dexiv2:png=enabled</option>
      <option>-Dexiv2:bmff=true</option>
      <option>-Dexiv2:iconv=disabled</option>
      <option>-Dexiv2:inih=disabled</option>
      <option>-Dexiv2:brotli=disabled</option>
      <option>-Dexiv2:curl=disabled</option>
      <option>-Dexiv2:nls=disabled</option>
      <option>-Dexiv2:webready=false</option>
      <option>-Dexiv2:video=false</option>
      <option>-Dexiv2:unitTests=disabled</option>
      <option>-Dgexiv2:introspection=false</option>
      <option>-Dgexiv2:vapi=false</option>
      <option>-Dgexiv2:gtk_doc=false</option>
      <option>-Dgexiv2:python3=false</option>
      <option>-Dgexiv2:tools=false</option>
      <option>-Dgexiv2:tests=false</option>
    </configure-options>
  </build>
</app>
